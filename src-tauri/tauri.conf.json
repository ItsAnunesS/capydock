{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapyDock",
  "version": "0.1.0",
  "identifier": "io.github.protondrive.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CapyDock",
        "width": 1280,
        "height": 840,
        "minWidth": 780,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Sincronize seu Linux com o Proton Drive",
    "longDescription": "CapyDock é um aplicativo independente para sincronizar arquivos no Linux. Inclui o CLI oficial da Proton com atualização verificada.",
    "resources": {
      "../bin/proton-drive": "bin/proton-drive",
      "../bin/release.json": "bin/release.json",
      "../bin/PROTON-SDK-LICENSE.md": "bin/PROTON-SDK-LICENSE.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../bin/proton-drive-computers": "bin/proton-drive-computers",
      "../bin/computers-release.json": "bin/computers-release.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libsecret-1-0",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libsecret",
          "libappindicator-gtk3"
        ],
        "compression": {
          "type": "gzip",
          "level": 6
        }
      }
    }
  }
}
